{
  // printup-editor — ArtiosCAD DXF viewer (cad-viewer) static deployment.
  // Build first: pnpm exec nx run @mlightcad/cad-viewer-example:build
  // Deploy:      wrangler deploy   (via ~/Workspace/Runtimes/Wrangler/bin/wrangler
  //               with WRANGLER_MOUNT_WORKSPACE=1 from this directory)
  "name": "printup-editor",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./packages/cad-viewer-example/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "printup-editor.runlumi.app",
      "custom_domain": true
    }
  ]
}
